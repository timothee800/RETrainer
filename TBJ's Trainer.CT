    <CheatEntry>
      <ID>1337122095</ID>
      <Description>"Custom Game Section"</Description>
      <Options moHideChildren="1"/>
      <Color>D7EA26</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>1337121300</ID>
          <Description>"Remove Custom Game RP Gain Decrease"</Description>
          <Options moHideChildren="1"/>
          <Color>51C4BB</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : REResistance.exe
  Version: 1.00
  Date   : 2023-08-07
  Author : TBJ
}

[ENABLE]
aobscanmodule(INJECTcustomsrp,REResistance.exe,F3 44 0F 10 40 34 EB)
alloc(newmem,$36,INJECTcustomsrp)
label(code)
label(return)

newmem:
push rbx
mov rbx,[rsp+218]
mov rbx,[rbx+118]
cmp [rbx+14],2
jne code
mov ebx,64
cvtsi2ss xmm8,ebx
pop rbx
jmp return
code:
pop rbx
movss xmm8,[rax+34]
jmp return

INJECTcustomsrp:
jmp newmem
nop
return:
registersymbol(INJECTcustomsrp)

[DISABLE]
INJECTcustomsrp:
  db F3 44 0F 10 40 34

unregistersymbol(INJECTcustomsrp)
dealloc(newmem)
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>1337122096</ID>
          <Description>"Treat Custom Games like Quick Match (RP, Missions, Achievements, RP Boosters)"</Description>
          <Options moHideChildren="1"/>
          <Color>42DD59</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : REResistance.exe
  Version: 1.11
  Date   : 2024-09-29
  Author : TBJ
}

[ENABLE]
aobscanmodule(INJECTcusqm,REResistance.exe,06 02 32 C9 EB 16 83 78 14 04 75 04)
aobscanmodule(INJECTdcty,REResistance.exe,8B 01 41 89 42 14)
aobscanmodule(INJECTnopecupu,REResistance.exe,46 50 0F 57 C9 F3 0F 5A C8 48 8B 48 18)
aobscanmodule(INJECTgmex,REResistance.exe,39 50 14 0F 84 D5 00 00 00)
alloc(newmem,$27,INJECTcusqm)
alloc(newmem2,$3A,INJECTdcty)
alloc(newmem3,$24,INJECTnopecupu)
alloc(newmem4,$29,INJECTgmex)
alloc(cpus,1,INJECTcusqm)
label(code)
label(code2)
label(code3)
label(code4)
label(return)
label(return2)
label(return3)
label(return4)

cpus:
db 0

newmem:
cmp dword ptr [rax+14],02
jne code2
mov dword ptr [rax+14],00
mov byte ptr [cpus],1
code2:
cmp dword ptr [rax+14],04
jne INJECTcusqm+10
jmp return

INJECTcusqm+06:
jmp newmem
nop
return:
registersymbol(INJECTcusqm)

newmem2:
mov eax,[rcx]
push r9
cmp byte ptr [cpus],1
jne code
mov r9,["REResistance.exe"+09DDBB70]
mov r9,[r9+98]
cmp r8,r9
jne code
pop r9
jmp return2
code:
pop r9
mov [r10+14],eax
jmp return2

INJECTdcty:
  jmp newmem2
  nop
return2:
registersymbol(INJECTdcty)

newmem3:
cmp byte ptr [cpus],1
jne code3
xorps xmm0,xmm0
mov byte ptr [cpus],0
code3:
cvtss2sd xmm1,xmm0
mov rcx,[rax+18]
jmp return3

INJECTnopecupu+05:
jmp newmem3
nop 3
return3:
registersymbol(INJECTnopecupu)

newmem4:
cmp byte ptr [cpus],1
jne code4
mov [rax+14],2
mov byte ptr [cpus],0
code4:
cmp [rax+14],edx
je INJECTgmex+DE
jmp return4

INJECTgmex:
jmp newmem4
nop 4
return4:
registersymbol(INJECTgmex)

[DISABLE]
INJECTcusqm+06:
  db 83 78 14 04 75 04

INJECTdcty:
  db 8B 01 41 89 42 14

INJECTnopecupu+05:
  db F3 0F 5A C8 48 8B 48 18

INJECTgmex:
  db 39 50 14 0F 84 D5 00 00 00

unregistersymbol(INJECTcusqm)
unregistersymbol(INJECTdcty)
unregistersymbol(INJECTnopecupu)
unregistersymbol(INJECTgmex)
dealloc(newmem)
dealloc(newmem2)
dealloc(newmem3)
dealloc(newmem4)
dealloc(cpus)
</AssemblerScript>
