do
  local t = createTimer(nil)
  t.Interval = 100
  t.OnTimer = function(timer)
    local memo = TrainerForm and TrainerForm.RedMemo
    if memo == nil then return end
    memo.Font.Color = 0x0000FF
    timer.Enabled = false
    timer.destroy()
  end
end

