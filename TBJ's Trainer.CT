          <ID>1337122834</ID>
          <Description>"(Obsolete) Force Start Match (MM usage)"</Description>
          <Color>000066</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : REResistance.exe
  Version: 1.12
  Date   : 2025-02-01
  Author : TBJ
}

[ENABLE]
aobscanmodule(brolo,REResistance.exe,44 38 BF 72 01 00 00)
aobscanmodule(INJECTbrlo2,REResistance.exe,48 8B 40 10 48 C1 E8 20 84 C0 74 02 FF C7 48 8D 54 24 20 48 8B CB E8 43)
alloc(newmem,$A9,brolo)
alloc(newmem2,$A6,INJECTbrlo2)
label(code)
label(return)

newmem:
cmp [rdi+154],0
jne code
cmp [rdi+14C],0
jne code
mov rbp,["REResistance.exe"+09DD9110]
cmp [rbp+13C],1
jne code
mov rbp,["REResistance.exe"+09DDD078]
mov rbp,[rbp+118]
cmp [rbp+14],2
jae code
mov rbp,["REResistance.exe"+09DE1E28]
mov rbp,[rbp+B88]
test rbp,rbp
je code
cmp [rbp+88],0
je code
cmp [rbp+F0],FFFFFFFF
je code
cmp qword ptr [rbp+118],0
je code
cmp qword ptr [rbp+120],0
je code
mov byte ptr [rdi+00000172],1
code:
cmp [rdi+00000172],r15l
jmp return

brolo:
jmp newmem
nop 2
return:
registersymbol(brolo)

newmem2:
cmp [rbp+14C],0
jne npu
cmp [rbp+154],0
jne npu
mov rdx,["REResistance.exe"+09DD9110]
cmp [rdx+13C],1
jne npu
mov rdx,["REResistance.exe"+09DDD078]
mov rdx,[rdx+118]
cmp [rdx+14],2
jae npu
mov rdx,["REResistance.exe"+09DE1E28]
mov rdx,[rdx+B88]
test rdx,rdx
je npu
cmp [rdx+88],0
je npu
cmp [rdx+F0],FFFFFFFF
je npu
cmp qword ptr [rdx+118],0
je npu
cmp qword ptr [rdx+120],0
je npu
inc [rax+14]
npu:
mov rax,[rax+10]
shr rax,20
jmp return2

INJECTbrlo2:
  jmp newmem2
  nop 3
return2:
registersymbol(INJECTbrlo2)

[DISABLE]
brolo:
  db 44 38 BF 72 01 00 00

INJECTbrlo2:
  db 48 8B 40 10 48 C1 E8 20

unregistersymbol(brolo)
dealloc(newmem)
unregistersymbol(INJECTbrlo2)
dealloc(newmem2)
</AssemblerScript>
