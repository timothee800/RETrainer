label(code)
label(return)

frameratecap:
db 01 00 00 70 42 00 00 70 41

newmem:
  cmp byte ptr [frameratecap],01
  jne code
  movss xmm1,[frameratecap+01]
  comiss xmm1,[frameratecap+05]
  jnb return
  movss xmm1,[frameratecap+05]
  jmp return
code:
  movss xmm1,[rbx+0000039C]
  jmp return

INJECTframerate:
  jmp newmem
  nop 3
return:
registersymbol(INJECTframerate)

[DISABLE]
INJECTframerate:
  db F3 0F 10 8B 9C 03 00 00

unregistersymbol(INJECTframerate)
unregistersymbol(frameratecap)
dealloc(newmem)
dealloc(frameratecap)
