[ENABLE]
aobscanmodule(INJECTps2tlk,REResistance.exe,85 C0 0F 85 E4 00 00 00 39)
aobscanmodule(INJECTplvcvl,REResistance.exe,F3 0F 11 43 20 F3 0F 5C)
alloc(newmem,$42,INJECTps2tlk)
alloc(newmem2,$EA,INJECTplvcvl)
alloc(ps2tlk,6,INJECTps2tlk)
alloc(plvc0,25,INJECTplvcvl)
alloc(vcpnter,8,INJECTplvcvl)
registersymbol(ps2tlk)
registersymbol(plvc0)

ps2tlk:
db 00 00 00 00 00 00

plvc0:
db 01 01 00 00 C8 42 01 00 00 C8 42 01 00 00 C8 42 01 00 00 C8 42 00 00 C8 42

vcpnter:
dq 0

newmem:
  test eax,eax
  jne code
  cmp byte ptr [ps2tlk+01],01
  je code
  ja skpn
  cmp byte ptr [ps2tlk],01
  jb skpn
code:
  test eax,eax
  jne INJECTps2tlk+EC
  jmp return
skpn:
  mov eax,3
  inc [ps2tlk+02]
  jmp code
INJECTps2tlk:
  jmp newmem
  nop 3
return:
registersymbol(INJECTps2tlk)

newmem2:
  lea rcx,[plvc0+01]
  cmp byte ptr [rcx-01],01
  jb code2
  mov rax,[REResistance.g_pAKPluginList+108]
  mov rax,[rax+08]
  mov rax,[rax+30]
  mov r9,FFFFFFFFFFFFFFFF
  mov r10,[rax+40]
  test r10,r10
  je code2
  xchg [vcpnter],r10
  test r10,r10
  je chnsl
  cmp [vcpnter],r10
  je chnsl
  mov [rcx+01],42C80000
  mov [rcx+06],42C80000
  mov [rcx+0B],42C80000
  mov [rcx+10],42C80000
chnsl:
  inc r9
  mov rax,[rax+40]
  test rax,rax
  je code2
  cmp qword ptr [rax+20],00
  je chnsl
  mov r10d,[rax+168]
  mov r11d,r10d
  and r10d,03
  cmp r10d,03
  je chnsl
  mov r8,[rax+50]
  shr r11d,03
  test r11d,01
  jne chnsl
  mov r8,[r8+88]
  mov r8,[r8+F8]
  cmp r8,rbx
  je slfov
  jmp chnsl
slfov:
  imul r9,5
  cmp byte ptr [rcx+r9],01
  jl code2
  mulss xmm0,[rcx+r9+01]
  divss xmm0,[rcx+14]
code2:
  movss [rbx+20],xmm0
  jmp return2

INJECTplvcvl:
  jmp newmem2
return2:
registersymbol(INJECTplvcvl)

[DISABLE]
INJECTps2tlk:
  db 85 C0 0F 85 E4 00 00 00

INJECTplvcvl:
  db F3 0F 11 43 20

unregistersymbol(INJECTps2tlk)
unregistersymbol(INJECTplvcvl)
unregistersymbol(ps2tlk)
unregistersymbol(plvc0)
dealloc(newmem)
dealloc(newmem2)
dealloc(ps2tlk)
dealloc(plvc0)
dealloc(vcpnter)

</AssemblerScript>
