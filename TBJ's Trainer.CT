[ENABLE]
aobscanmodule(INJECTbgm,REResistance.exe,CC 8B 82 88 00 00 00 C3)
alloc(newmem,$4D,INJECTbgm)
alloc(bgm,1,INJECTbgm)
registersymbol(bgm)
label(code)
label(return)

bgm:
db 02

newmem:
  cmp rdx,[REResistance.exe+9DDD078]
  mov eax,[rdx+00000088]
  jne code
  cmp byte ptr [bgm],00
  je code
  cmp eax,1
  je pcd
  cmp eax,6
  je pcd
  cmp eax,20
  jne code
pcd:
  movzx eax,[bgm]
code:
  jmp return

INJECTbgm+01:
  jmp newmem
  nop
return:
registersymbol(INJECTbgm)

[DISABLE]
INJECTbgm+01:
  db 8B 82 88 00 00 00

unregistersymbol(INJECTbgm)
dealloc(newmem)
dealloc(bgm)
unregistersymbol(bgm)
</AssemblerScript>
